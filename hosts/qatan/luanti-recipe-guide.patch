-local function search(data)
+local function count_ingredients(player)
+	local counts = {}
+	local inventory = player:get_inventory()
+	for _, list in ipairs({"main", "craft"}) do
+		for _, stack in ipairs(inventory:get_list(list) or {}) do
+			if stack:is_known() and not stack:is_empty() then
+				local name = stack:get_name()
+				counts[name] = (counts[name] or 0) + stack:get_count()
+			end
+		end
+	end
+	return counts
+end
+
+-- Move an already assigned item to another slot if two groups need it.
+local function assign_group(group, candidates, assigned, seen)
+	for _, slot in ipairs(candidates[group]) do
+		if not seen[slot] then
+			seen[slot] = true
+			if not assigned[slot] or assign_group(assigned[slot], candidates, assigned, seen) then
+				assigned[slot] = group
+				return true
+			end
+		end
+	end
+	return false
+end
+
+local function has_ingredients(recipe, counts)
+	if recipe.type ~= "normal" and recipe.type ~= "cooking" then
+		return false
+	end
+
+	local reserved, groups = {}, {}
+	for _, ingredient in pairs(recipe.items) do
+		if ingredient:sub(1, 6) == "group:" then
+			groups[#groups + 1] = extract_groups(ingredient)
+		elseif ingredient ~= "" then
+			local stack = ItemStack(ingredient)
+			local name = stack:get_name()
+			reserved[name] = (reserved[name] or 0) + stack:get_count()
+			if reserved[name] > (counts[name] or 0) then
+				return false
+			end
+		end
+	end
+	if #groups == 0 then
+		return true
+	end
+
+	local candidates, slot = {}, 0
+	for i in ipairs(groups) do candidates[i] = {} end
+	for name, count in pairs(counts) do
+		local available = math.min(count - (reserved[name] or 0), #groups)
+		if available > 0 then
+			local item_groups = core.registered_items[name].groups
+			for i, required_groups in ipairs(groups) do
+				if item_has_groups(item_groups, required_groups) then
+					for j = 1, available do
+						table.insert(candidates[i], slot + j)
+					end
+				end
+			end
+			slot = slot + available
+		end
+	end
+
+	local assigned = {}
+	for i in ipairs(groups) do
+		if not assign_group(i, candidates, assigned, {}) then
+			return false
+		end
+	end
+	return true
+end
+
+local function has_available_recipe(item, counts, player)
+	for _, recipe in ipairs(apply_recipe_filters(get_item_recipes(item), player)) do
+		if has_ingredients(recipe, counts) then
+			return true
+		end
+	end
+	return false
+end
+
