@@ -130,17 +145,65 @@
 					return
 				end
 			end
-		elseif self._mode == "cannon" then
-			local o = self.object
-			o:set_acceleration(gravity)
 		end
 	end,
+	-- The engine treats map that isn't loaded (or generated) yet as solid, so
+	-- a fast flight would "hit" the edge of the loaded world in mid-air.
+	-- Instead of dropping the passenger there, hover until the map ahead has
+	-- arrived, then carry on with the velocity we had.
+	_cannon_step = function (self, dt, moveresult)
+		local o = self.object
+		local pos = o:get_pos()
+		local pos_unloaded = is_unloaded(pos)
+		local unloaded_hit = false
+		if moveresult and moveresult.collides then
+			for _, c in ipairs(moveresult.collisions) do
+				if c.type == "node" and is_unloaded(c.node_pos) then
+					unloaded_hit = true
+				else
+					o:remove()
+					return
+				end
+			end
+		end
+
+		if not (self._frozen or unloaded_hit or pos_unloaded) or not self._vel then
+			self._vel = o:get_velocity()
+		end
+		local vel = self._vel
+
+		self._emerge_time = (self._emerge_time or 0) - dt
+		if self._emerge_time <= 0 then
+			self._emerge_time = 0.5
+			for t = 0.5, 3, 0.5 do
+				local p = pos + vel * t + gravity * (0.5 * t * t)
+				core.emerge_area(vector.subtract(p, 16), vector.add(p, 16))
+			end
+		end
+
+		if unloaded_hit or pos_unloaded or is_unloaded(pos + vel * cannon_lookahead) then
+			self._frozen = (self._frozen or 0) + dt
+			if self._frozen > cannon_max_wait then
+				o:remove()
+				return
+			end
+			o:set_velocity(vector.zero())
+			o:set_acceleration(vector.zero())
+			return
+		end
+
+		if self._frozen then
+			self._frozen = nil
+			o:set_velocity(vel)
+		end
+		o:set_acceleration(gravity)
+	end,
 	get_staticdata = function (self)
 		return core.write_json({
 			child_guid = self.child_guid,
 			mode = self._mode,
 			origin = self._origin,
-			vel = self.object:get_velocity(),
+			vel = self._frozen and self._vel or self.object:get_velocity(),
 			area = self._area, --needed for beams
 		})
 	end,
