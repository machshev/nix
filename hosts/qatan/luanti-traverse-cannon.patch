 local corner_one = vector.new(-0.5,-0.5,-0.5)
 local gravity = vector.new(0,-9.81,0)
 
+-- Cannon flights wait for the map this many seconds ahead of them to load,
+-- and give up (dropping the passenger) after hovering for cannon_max_wait.
+local cannon_lookahead = 0.3
+local cannon_max_wait = 30
+
+local function is_unloaded(pos)
+	local node = core.get_node_or_nil(pos)
+	return not node or node.name == "ignore"
+end
+
 local has_digilines = core.get_modpath("digilines") and true
 
 
